{
  "version": 2,
  "builds": [
    {
      "src": "backend/fastapi_services/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11",
        "installCommand": "pip install -r requirements-prod.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/fastapi_services/main.py"
    }
  ]
}

