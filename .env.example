# ============================================
# Air Quality Platform - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DEBUG=true
APP_HOST=0.0.0.0
FASTAPI_PORT=8000
FLASK_PORT=5000
STREAMLIT_PORT=8501

# --- Database ---
DATABASE_URL=sqlite:///./air_quality.db
# For PostgreSQL: postgresql://user:password@localhost:5432/air_quality
# For MySQL: mysql+pymysql://user:password@localhost:3306/air_quality

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# --- JWT Authentication ---
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- External APIs ---
OPENWEATHER_API_KEY=
AQICN_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- AI/LLM ---
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=simulated

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- ML Models ---
MODEL_CACHE_DIR=./ml_model_cache
MODEL_VERSION=v1.0.0

# --- Feature Flags ---
ENABLE_CNN_SATELLITE=false
ENABLE_CROWD_DETECTION=false
ENABLE_BLOCKCHAIN_LOGS=false
ENABLE_REAL_APIS=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
